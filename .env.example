DATABASE_URL=postgres://synrgy:synrgy@localhost:5432/synrgy
PORT=4000
NODE_ENV=development
SESSION_TTL_DAYS=7

# Where the web app is served. Used for emailed links and allowed as a request origin.
CLIENT_ORIGIN=http://localhost:5173
# APP_URL=https://hr.example.com        # defaults to CLIENT_ORIGIN
# ALLOWED_ORIGINS=https://other.example # extra origins allowed to make changes, comma-separated

# Email: console (dev default, prints to the API log) | resend | webhook | none (production default)
# MAIL_PROVIDER=resend
# MAIL_FROM="Acme HR <hr@acme.example>"
# RESEND_API_KEY=re_...
# MAIL_WEBHOOK_URL=https://example.com/hooks/email   # receives {from,to,subject,text} as JSON

# RATE_LIMITS=on
# PASSWORD_RESET_TTL_MINUTES=60
